---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatCompactDate,
  getPostTags,
  postUrl,
  sortPosts,
  tagUrl,
} from "../lib/posts";

const sortedPosts = sortPosts(await getCollection("posts"));
const DESCRIPTION_LIMIT = 100;

function truncateDescription(description: string): string {
  if (description.length <= DESCRIPTION_LIMIT) return description;

  const truncated = description.slice(0, DESCRIPTION_LIMIT + 1);
  const lastSpace = truncated.lastIndexOf(" ");
  return `${truncated.slice(0, lastSpace > 0 ? lastSpace : DESCRIPTION_LIMIT).trimEnd()}…`;
}
---

<BaseLayout>
  <section class="post-index" aria-label="Blog posts">
    {
      sortedPosts.map((post) => {
        const tags = getPostTags(post);
        return (
          <article class="post-index-item">
            <div class="post-index-meta">
              <time datetime={post.data.date.toISOString()}>
                {formatCompactDate(post.data.date)}
              </time>
              {tags.length > 0 && (
                <span class="post-index-tags" aria-label="Tags">
                  {tags.map((tag) => (
                    <a href={tagUrl(tag)}>{tag}</a>
                  ))}
                </span>
              )}
            </div>
            <h2>
              <a href={postUrl(post)}>{post.data.title}</a>
            </h2>
            <p class="post-index-description">
              {truncateDescription(post.data.description)}
            </p>
          </article>
        );
      })
    }
  </section>
</BaseLayout>
