---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatCompactDate,
  getAllTags,
  getPostTags,
  postUrl,
  sortPosts,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return [...getAllTags(posts).keys()].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const posts = await getCollection("posts");
const normalizedPosts = sortPosts(
  posts.filter((post) => getPostTags(post).includes(tag ?? "")),
);
---

<BaseLayout
  title={`Posts tagged ${tag}`}
  description={`Posts tagged with ${tag} on Hootpy Blog`}
>
  <section class="listing-page">
    <a class="back-link" href="/tags/">← All tags</a>
    <h1>Posts tagged with {tag}</h1>
    <div class="single-column-list">
      {
        normalizedPosts.map((post) => (
          <article class="post-index-item">
            <div class="post-index-meta">
              <time datetime={post.data.date.toISOString()}>
                {formatCompactDate(post.data.date)}
              </time>
            </div>
            <h2>
              <a href={postUrl(post)}>{post.data.title}</a>
            </h2>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
